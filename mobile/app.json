{
    "expo": {
        "name": "NeuroNest",
        "slug": "neuronest-mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/logo.png",
        "userInterfaceStyle": "dark",
        "splash": {
            "image": "./assets/logo.png",
            "resizeMode": "contain",
            "backgroundColor": "#0a0514"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.neuronest.app",
            "buildNumber": "1.0.0"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/logo.png",
                "backgroundColor": "#0a0514"
            },
            "package": "com.neuronest.app",
            "versionCode": 1,
            "permissions": [
                "INTERNET",
                "ACCESS_NETWORK_STATE"
            ]
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "extra": {
            "eas": {
                "projectId": "your-project-id"
            }
        },
        "plugins": [
            "expo-secure-store"
        ]
    }
}