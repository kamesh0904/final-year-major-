{
    "expo": {
        "name": "NeuroNest",
        "slug": "neuronest-mobile",
        "scheme": "neuronest",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/logo.png",
        "userInterfaceStyle": "dark",
        "splash": {
            "image": "./assets/logo.png",
            "resizeMode": "contain",
            "backgroundColor": "#0a0514"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.neuronest.app",
            "buildNumber": "1.0.0"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/logo.png",
                "backgroundColor": "#0a0514"
            },
            "package": "com.neuronest.app",
            "versionCode": 1,
            "permissions": [
                "INTERNET",
                "ACCESS_NETWORK_STATE",
                "RECEIVE_BOOT_COMPLETED",
                "SCHEDULE_EXACT_ALARM",
                "POST_NOTIFICATIONS"
            ]
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "extra": {
            "eas": {
                "projectId": "your-project-id"
            }
        },
        "plugins": [
            "expo-secure-store",
            [
                "expo-notifications",
                {
                    "icon": "./assets/logo.png",
                    "color": "#7C3AED",
                    "defaultChannel": "neuronest-quests"
                }
            ]
        ]
    }
}